# Environment Variables for Google Photos Discovery Engine
# Copy this file to .env and fill in your values.

# --- LLM ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Reddit API (PRAW) ---
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=google-photos-discovery-engine/1.0

# --- Paths ---
DATA_DIR=./data

# --- Logging ---
LOG_LEVEL=INFO

# --- Safety ---
DRY_RUN=true
